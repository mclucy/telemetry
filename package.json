{
  "name": "lucy-telemetry-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "cargo check --target wasm32-unknown-unknown",
    "fmt": "cargo fmt --all",
    "build:production": "worker-build --release && vp build --mode production",
    "deploy-check:production": "cf deploy --prebuilt --mode production --dry-run --provision=false",
    "deploy:production": "cf deploy --prebuilt --mode production --provision=false",
    "triggers:production": "cf workers triggers deploy --prebuilt --mode production",
    "migrate": "cf d1 migrations apply \"$LUCY_TELEMETRY_D1_ID\" --dir migrations"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.28",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "pnpm@12.18.0"
}
