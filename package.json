{
  "name": "lucy-telemetry-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "cargo check --target wasm32-unknown-unknown",
    "fmt": "cargo fmt --all",
    "build": "scripts/install-worker-build.sh && worker-build --release && vp build --mode production",
    "deploy": "cf deploy --prebuilt --mode production --provision=false",
    "triggers": "cf workers triggers deploy --prebuilt --mode production",
    "migrate": "cf d1 migrations apply \"$LUCY_TELEMETRY_D1_ID\" --dir migrations"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-rc.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
